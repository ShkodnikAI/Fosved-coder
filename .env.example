# ───────────────────────────────────────────────────────────────
# Fosved Coder — переменные окружения (шаблон)
# Скопируй в .env и заполни. .env в git не попадает (.gitignore).
# Все переменные опциональные — если не задано, читается из config.yaml
# либо используется значение по умолчанию.
# ───────────────────────────────────────────────────────────────

# === Сервер ===
# Порт HTTP-сервера (по умолчанию 8000). Render задаёт автоматически.
PORT=8000

# Внешний URL приложения (используется в логах). Render задаёт автоматически.
# RENDER_EXTERNAL_URL=https://fosved-coder.onrender.com

# === База данных ===
# Если задано — используется PostgreSQL вместо SQLite.
# Поддерживаются форматы: postgres://, postgresql://, sqlite+aiosqlite:///...
# Примеры провайдеров: Supabase, Neon, Render Postgres.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Путь к файлу keys.yaml (по умолчанию ./keys.yaml).
# KEYS_FILE_PATH=keys.yaml

# === API-ключи провайдеров ИИ (по одному на провайдер) ===
# Можно задавать в .env ЛИБО в keys.yaml через UI — env имеет приоритет.

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-proj-...
# XAI_API_KEY=xai-...
# GEMINI_API_KEY=...
# GOOGLE_API_KEY=...
# MOONSHOT_API_KEY=...
# DEEPSEEK_API_KEY=...
# QWEN_API_KEY=...
# ZAI_API_KEY=...
# ABACUS_API_KEY=...
# CEREBRAS_API_KEY=...          # Бесплатный: https://cloud.cerebras.ai
# GROQ_API_KEY=...              # Бесплатный: https://console.groq.com

# === Интеграции ===
# GitHub PAT для git clone/push приватных репозиториев.
# GITHUB_TOKEN=ghp_...

# Expo (если используется apk_builder).
# EXPO_TOKEN=...
